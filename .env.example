# Leave DEVICE_IP blank to auto-discover the terminal by MAC address on
# whatever local network this host is on. Set it explicitly to skip discovery.
DEVICE_IP=
DEVICE_MAC=BC:9B:5E:1A:1D:87
DEVICE_PROTOCOL=http
DEVICE_USER=admin
DEVICE_PASS=changeme

PORT=3070
FACE_TERMINAL_DATA=./data
POLL_INTERVAL_MS=1500

# Any scan before this time (24h HH:MM) counts as "in"; the first scan at
# or after it counts as "out". Further same-side scans that day are ignored.
CHECKOUT_AFTER=19:00

RECEIVER_IP=10.10.11.194

# --- optional second device: DS-K2802 card-reader controller ---------------
# Leave CARD_DEVICE_IP blank/unset to run with just the face terminal above,
# exactly as before -- nothing below is required. Set CARD_DEVICE_IP to also
# listen to a DS-K2802 controller for card-swipe check-ins alongside the
# face terminal. Unlike the face terminal, this device has no auto-discovery
# (it speaks a different protocol the discovery scan can't probe) -- the IP
# must be set explicitly and pinned (it doesn't move between sites the way
# the face terminal does). Credentials default to DEVICE_USER/DEVICE_PASS
# above if left blank (only set these if the card controller uses a
# different admin login).
CARD_DEVICE_IP=
CARD_DEVICE_USER=
CARD_DEVICE_PASS=
