# Leave DEVICE_IP blank to auto-discover the terminal by MAC address on
# whatever local network this host is on. Set it explicitly to skip discovery.
DEVICE_IP=
DEVICE_MAC=BC:9B:5E:1A:1D:87
DEVICE_PROTOCOL=http
DEVICE_USER=admin
DEVICE_PASS=changeme

PORT=3070
FACE_TERMINAL_DATA=./data
POLL_INTERVAL_MS=1500

# Any scan before this time (24h HH:MM) counts as "in"; the first scan at
# or after it counts as "out". Further same-side scans that day are ignored.
CHECKOUT_AFTER=19:00

RECEIVER_IP=10.10.11.194
